<Window x:Class="LabWork22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт расписания" Height="230" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Дата:" VerticalAlignment="Center"/>
        <DatePicker x:Name="datePicker" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Кинотеатр:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cinemaBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,15"/>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Height="32" Margin="0,0,0,10"
                Content="3.1 Сохранить в csv (выбранный кинотеатр)" Click="CsvButton_Click"/>
        <Button Grid.Row="3" Grid.ColumnSpan="2" Height="32"
                Content="3.2 Сохранить в xlsx (все кинотеатры)" Click="XlsxButton_Click"/>
    </Grid>
</Window>
